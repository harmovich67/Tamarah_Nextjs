# ------------------------------------------------------------------
# Tamrna storefront (Next.js) - environment
# Copy to .env.local. Never commit real secrets.
# ------------------------------------------------------------------

# API adapter: "mock" (in-browser demo data, default) or "laravel" (REST adapter)
NEXT_PUBLIC_API_MODE=mock

# Base URL of the Laravel API (only used when NEXT_PUBLIC_API_MODE=laravel), e.g. https://api.example.com/api
NEXT_PUBLIC_API_URL=

# How the SPA authenticates against Laravel: "token" (Bearer / Sanctum personal access tokens)
# or "cookie" (Sanctum SPA cookie session + CSRF)
NEXT_PUBLIC_AUTH_STRATEGY=token

# Public origin of this site (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the admin dashboard lives (links from /admin/login)
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:5173

# While the backend is partial (laravel mode): checkout, accounts, coupons, menus and settings stay on mock data.
NEXT_PUBLIC_MOCK_FALLBACK=true
