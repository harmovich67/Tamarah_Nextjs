# Public build settings (no secrets): used by `next build` on Vercel / cPanel when there is no .env.local.
# NEXT_PUBLIC_SITE_URL and NEXT_PUBLIC_DASHBOARD_URL are set per deployment, see docs/DEPLOY_VERCEL.md.
NEXT_PUBLIC_API_MODE=laravel
NEXT_PUBLIC_API_URL=https://tomorna.doha.aait-d.com/api
NEXT_PUBLIC_AUTH_STRATEGY=token
NEXT_PUBLIC_MOCK_FALLBACK=true
