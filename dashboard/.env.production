# Public build settings (no secrets): used by `vite build` on Vercel / cPanel when there is no .env.local.
# VITE_STOREFRONT_URL (link back to the store) is set per deployment, see docs/DEPLOY_VERCEL.md.
VITE_API_MODE=laravel
VITE_API_URL=https://tomorna.doha.aait-d.com/api
VITE_AUTH_STRATEGY=token
VITE_MOCK_FALLBACK=true
