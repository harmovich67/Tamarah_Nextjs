# ------------------------------------------------------------------
# Tamrna admin dashboard (React + Vite) - environment
# Copy to .env.local. Never commit real secrets.
# ------------------------------------------------------------------

# API adapter: "mock" (in-browser demo data, default) or "laravel" (REST adapter)
VITE_API_MODE=mock

# Base URL of the Laravel API (only used when VITE_API_MODE=laravel), e.g. https://api.example.com/api
VITE_API_URL=

# "token" (Laravel API tokens / Sanctum personal access tokens, Bearer) or "cookie" (Sanctum SPA cookie session)
VITE_AUTH_STRATEGY=token

# Public storefront (links "visit store")
VITE_STOREFRONT_URL=http://localhost:3000

# While the backend is partial (laravel mode): keep screens it does not expose yet on the in-browser mock data.
VITE_MOCK_FALLBACK=true
